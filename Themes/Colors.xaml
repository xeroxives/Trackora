<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Title Bar -->
    <SolidColorBrush x:Key="WindowButtonForeground" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="WindowButtonForegroundHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowButtonHoverBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="TitleBarBG" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="TitleBarTitleColor" Color="#0f0f0f"/>
    <SolidColorBrush x:Key="TitleBarBorder" Color="#282828"/>
    <!--E0E0E0-->
    
    <!-- Main Window -->
    <SolidColorBrush x:Key="BgPrimary" Color="#121212"/>
    
    <SolidColorBrush x:Key="BgButtonPlay" Color="#FFF"/>
    <SolidColorBrush x:Key="FgButtonPlay" Color="#000"/>

    <SolidColorBrush x:Key="BgHoverBtnPlay" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BgButtonSwitch" Color="#EEE"/>
    <SolidColorBrush x:Key="FgButtonSwitch" Color="#222"/>
    <SolidColorBrush x:Key="BgHoverBtnSwitch" Color="#FFF"/>

    <SolidColorBrush x:Key="BgSlider" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="FgSlider" Color="#1DB954"/>
    <SolidColorBrush x:Key="FgHoverSlider" Color="#1ED760"/>
    <SolidColorBrush x:Key="BgDotOnSlider" Color="#FFF"/>
    <SolidColorBrush x:Key="FgTimer" Color="#A0A0A0"/>
    
    <!-- Side Bar -->
    <SolidColorBrush x:Key="SidebarBg" Color="#181818"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#181818"/>
    <SolidColorBrush x:Key="SidebarBtnBg" Color="#00000000"/>
    <SolidColorBrush x:Key="SidebarBtnBgHover" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SidebarBtnBgPressed" Color="#3A3A3A"/>

    <SolidColorBrush x:Key="ScrollbarBg" Color="#121212"/>
    <SolidColorBrush x:Key="ScrollbarBgHover" Color="#808080"/>
    <SolidColorBrush x:Key="ScrollbarBgPressed" Color="#949494"/>
    <SolidColorBrush x:Key="ScrollbarThumbNormal" Color="#444"/>
    <SolidColorBrush x:Key="ScrollbarArrowNormal" Color="#777"/>

    
    <Color x:Key="VolumeTrackColor">#D1D5DB</Color>
    <Color x:Key="VolumeAccentColor">#00C6FF</Color>
    <Color x:Key="VolumeThumbColor">#FFFFFF</Color>
    <Color x:Key="VolumeGlowColor">#00E5FF</Color>
    <Color x:Key="VolumeGradientStartColor">#00F2A0</Color>
    <Color x:Key="VolumeGradientEndColor">#4AABFF</Color>

    <SolidColorBrush x:Key="VolumeTrackBrush" Color="{StaticResource VolumeTrackColor}"/>
    <SolidColorBrush x:Key="VolumeAccentBrush" Color="{StaticResource VolumeAccentColor}"/>
    <SolidColorBrush x:Key="VolumeThumbBrush" Color="{StaticResource VolumeThumbColor}"/>

    <LinearGradientBrush x:Key="VolumeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource VolumeGradientStartColor}"/>
        <GradientStop Offset="1" Color="{StaticResource VolumeGradientEndColor}"/>
    </LinearGradientBrush>
</ResourceDictionary>