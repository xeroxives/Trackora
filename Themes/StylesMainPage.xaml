<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ============================== -->
    <!-- ====== Main Page Styles ====== -->
    <!-- ============================== -->
    <Style TargetType="Button" x:Key="ControlButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Play/Pause Style ===== -->
    <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource ControlButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BgButtonPlay}"/>
        <Setter Property="Foreground" Value="{StaticResource FgButtonPlay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="24" 
                        Width="{TemplateBinding Width}" 
                        Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHoverBtnPlay}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Switch_Song_Buttons -->
    <Style TargetType="Button" x:Key="SwitchSongBtnStyle" BasedOn="{StaticResource ControlButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BgButtonSwitch}"/>
        <Setter Property="Foreground" Value="{StaticResource FgButtonSwitch}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="24" 
                        Width="{TemplateBinding Width}" 
                        Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHoverBtnSwitch}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Song_Progress_Slider ===== -->
    <Style TargetType="Slider" x:Key="ProgressSliderStyle">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="{Binding TotalDurationSeconds, FallbackValue=100}"/>
        <Setter Property="Value" Value="{Binding CurrentPositionSeconds, Mode=OneWay}"/>
        <Setter Property="Background" Value="{StaticResource BgSlider}"/>
        <Setter Property="Foreground" Value="{StaticResource FgSlider}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="AutoToolTipPlacement" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Grid Margin="6,0">
                            <Border x:Name="TrackBackground"
                                Background="{TemplateBinding Background}"
                                Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                    Height="4"
                                                    CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="12"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="0" Height="12" Opacity="0" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource BgDotOnSlider}"
                                                     Width="12" Height="12"
                                                     Margin="-6,0,-6,0"
                                                     StrokeThickness="0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource FgHoverSlider}"/>
                        </Trigger>
                        <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===== Volume_Slider ===== -->
    <Style x:Key="VolumeSliderStyle" TargetType="Slider">
        <Style.Resources>
            <Style x:Key="VolumeEmptyTrack" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" VerticalAlignment="Center" Height="4">
                                <Rectangle RadiusX="2" RadiusY="2" Height="4"
                                       Fill="{StaticResource VolumeTrackBrush}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VolumeFilledTrack" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" VerticalAlignment="Center" Height="4">
                                <Rectangle RadiusX="2" RadiusY="2" Height="4"
                                       Fill="{StaticResource VolumeFillBrush}">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.7"
                                                      Color="{StaticResource VolumeGlowColor}"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VolumeThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="16" Height="16"
                                     Fill="{StaticResource VolumeThumbBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9"
                                                      Color="{StaticResource VolumeAccentColor}"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="6" Height="6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{StaticResource VolumeAccentBrush}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>

        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeFilledTrack}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeEmptyTrack}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VolumeThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== ListtBox_Arrows_(UP-DOWN) ========== -->
    <Style x:Key="ScrollBarArrowButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 4 L 6 0 L 12 4 Z"
							  Width="12" Height="8"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка вниз (перевёрнутая) -->
	<Style x:Key="ScrollBarArrowDownButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 6 4 L 12 0 Z"
							  Width="12" Height="8"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка влево -->
	<Style x:Key="ScrollBarArrowLeftButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 4 0 L 0 6 L 4 12 Z"
							  Width="8" Height="12"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка вправо -->
	<Style x:Key="ScrollBarArrowRightButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 4 6 L 0 12 Z"
							  Width="8" Height="12"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ============================================= -->
	<!--  КНОПКИ ТРЕКА (прозрачные, без стрелок)       -->
	<!-- ============================================= -->
	<Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

    <!-- ========== THUMB (ползунок) ========== -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
							CornerRadius="5"
							Background="{StaticResource ScrollbarThumbNormal}"
							Width="10"
							Margin="2,0,2,0"
							SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
									Value="{StaticResource ScrollbarBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
									Value="{StaticResource ScrollbarBgPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============================================= -->
	<!--  SCROLLBAR — НЕЯВНЫЙ СТИЛЬ (применяется ко    -->
	<!--  всем ScrollBar автоматически)                -->
	<!-- ============================================= -->
	<Style TargetType="{x:Type ScrollBar}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Background" Value="{StaticResource ScrollbarBg}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ScrollBar}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition MaxHeight="16"/>
							<RowDefinition Height="*"/>
							<RowDefinition MaxHeight="16"/>
						</Grid.RowDefinitions>

						<Border Grid.RowSpan="3"
								Background="{TemplateBinding Background}"/>

						<RepeatButton Grid.Row="0"
									  Style="{StaticResource ScrollBarArrowButton}"
									  Command="ScrollBar.LineUpCommand"/>

						<Track Grid.Row="1"
							   x:Name="PART_Track"
							   IsDirectionReversed="True">
							<Track.DecreaseRepeatButton>
								<RepeatButton Style="{StaticResource ScrollBarTrackButton}"
											  Command="ScrollBar.PageUpCommand"/>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Style="{StaticResource ScrollBarThumb}"/>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Style="{StaticResource ScrollBarTrackButton}"
											  Command="ScrollBar.PageDownCommand"/>
							</Track.IncreaseRepeatButton>
						</Track>

						<RepeatButton Grid.Row="2"
									  Style="{StaticResource ScrollBarArrowDownButton}"
									  Command="ScrollBar.LineDownCommand"/>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="Orientation" Value="Horizontal">
							<Setter Property="Width" Value="Auto"/>
							<Setter Property="Height" Value="14"/>
							<Setter Property="MinHeight" Value="14"/>
						</Trigger>
						<Trigger Property="Orientation" Value="Vertical">
							<Setter Property="Width" Value="14"/>
							<Setter Property="MinWidth" Value="14"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>