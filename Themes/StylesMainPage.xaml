<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Button" x:Key="ControlButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Play/Pause Style -->
    <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource ControlButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BgButtonPlay}"/>
        <Setter Property="Foreground" Value="{StaticResource FgButtonPlay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="24" 
                        Width="{TemplateBinding Width}" 
                        Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHoverBtnPlay}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="SwitchSongBtnStyle" BasedOn="{StaticResource ControlButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BgButtonSwitch}"/>
        <Setter Property="Foreground" Value="{StaticResource FgButtonSwitch}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="24" 
                        Width="{TemplateBinding Width}" 
                        Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHoverBtnSwitch}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" x:Key="ProgressSliderStyle">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="{Binding TotalDurationSeconds, FallbackValue=100}"/>
        <Setter Property="Value" Value="{Binding CurrentPositionSeconds, Mode=OneWay}"/>
        <Setter Property="Background" Value="{StaticResource BgSlider}"/>
        <Setter Property="Foreground" Value="{StaticResource FgSlider}"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="AutoToolTipPlacement" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="RootGrid" Background="Transparent">

                        <Border x:Name="TrackBackground" 
                            Background="{TemplateBinding Background}" 
                            Height="4" 
                            CornerRadius="2" 
                            VerticalAlignment="Center"/>

                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" 
                                        Height="4" 
                                        CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="12"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="12" Height="12" Opacity="0" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource BgDotOnSlider}" Width="12" Height="12" StrokeThickness="0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource FgHoverSlider}"/>
                        </Trigger>
                        <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                            <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


	<!-- ============================================= -->
	<!--  КНОПКИ-СТРЕЛКИ (вверх / вниз)                -->
	<!-- ============================================= -->
	<Style x:Key="ScrollBarArrowButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 4 L 6 0 L 12 4 Z"
							  Width="12" Height="8"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка вниз (перевёрнутая) -->
	<Style x:Key="ScrollBarArrowDownButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 6 4 L 12 0 Z"
							  Width="12" Height="8"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка влево -->
	<Style x:Key="ScrollBarArrowLeftButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 4 0 L 0 6 L 4 12 Z"
							  Width="8" Height="12"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Стрелка вправо -->
	<Style x:Key="ScrollBarArrowRightButton" TargetType="{x:Type RepeatButton}"
		   BasedOn="{StaticResource ScrollBarArrowButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True">
						<Path x:Name="Arrow"
							  Fill="{StaticResource ScrollbarArrowNormal}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 4 6 L 0 12 Z"
							  Width="8" Height="12"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Arrow" Property="Fill"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ============================================= -->
	<!--  КНОПКИ ТРЕКА (прозрачные, без стрелок)       -->
	<!-- ============================================= -->
	<Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" SnapsToDevicePixels="True"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ============================================= -->
	<!--  THUMB (ползунок)                             -->
	<!-- ============================================= -->
	<Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Border x:Name="ThumbBorder"
							CornerRadius="5"
							Background="{StaticResource ScrollbarThumbNormal}"
							Width="10"
							Margin="2,0,2,0"
							SnapsToDevicePixels="True"/>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ThumbBorder" Property="Background"
									Value="{StaticResource ScrollbarBgHover}"/>
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="ThumbBorder" Property="Background"
									Value="{StaticResource ScrollbarBgPressed}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ============================================= -->
	<!--  SCROLLBAR — НЕЯВНЫЙ СТИЛЬ (применяется ко   -->
	<!--  всем ScrollBar автоматически)                -->
	<!-- ============================================= -->
	<Style TargetType="{x:Type ScrollBar}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Background" Value="{StaticResource ScrollbarBg}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ScrollBar}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition MaxHeight="16"/>
							<RowDefinition Height="*"/>
							<RowDefinition MaxHeight="16"/>
						</Grid.RowDefinitions>

						<Border Grid.RowSpan="3"
								Background="{TemplateBinding Background}"/>

						<RepeatButton Grid.Row="0"
									  Style="{StaticResource ScrollBarArrowButton}"
									  Command="ScrollBar.LineUpCommand"/>

						<Track Grid.Row="1"
							   x:Name="PART_Track"
							   IsDirectionReversed="True">
							<Track.DecreaseRepeatButton>
								<RepeatButton Style="{StaticResource ScrollBarTrackButton}"
											  Command="ScrollBar.PageUpCommand"/>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Style="{StaticResource ScrollBarThumb}"/>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Style="{StaticResource ScrollBarTrackButton}"
											  Command="ScrollBar.PageDownCommand"/>
							</Track.IncreaseRepeatButton>
						</Track>

						<RepeatButton Grid.Row="2"
									  Style="{StaticResource ScrollBarArrowDownButton}"
									  Command="ScrollBar.LineDownCommand"/>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="Orientation" Value="Horizontal">
							<Setter Property="Width" Value="Auto"/>
							<Setter Property="Height" Value="14"/>
							<Setter Property="MinHeight" Value="14"/>
						</Trigger>
						<Trigger Property="Orientation" Value="Vertical">
							<Setter Property="Width" Value="14"/>
							<Setter Property="MinWidth" Value="14"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>