        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp14.Views"
        mc:Ignorable="d" Background="{StaticResource BgPrimary}"
        Title="EditMetadataWindow" Height="400" Width="450">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Soon.." Foreground="#FFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" Margin="5"/>
            <TextBlock Foreground="#FFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Margin="5" x:Name="tb"/>
            <Button Content="Exit" Click="Button_Click" Margin="5"/>
        </StackPanel>
        
    </Grid>
</Window>
