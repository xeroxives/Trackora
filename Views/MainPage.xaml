<UserControl x:Class="WpfApp14.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:WpfApp14.Converters"
      xmlns:viewmodels="clr-namespace:WpfApp14.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:MainPageVM}"
      mc:Ignorable="d" Background="#121212" >

    <UserControl.Resources>
        <converters:TimeConverter x:Key="TimeConv"/>
        <converters:StringToImageConverter x:Key="StrImgConv"/>
        <converters:ProgressWidthConverter x:Key="ProgressWidthConv"/>
        <converters:BoolToSaveTextConverter x:Key="BoolToSaveTextConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConv"/>
        <!-- Style of btns -->
        <Style TargetType="Button" x:Key="ControlButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Play/Pause Style -->
        <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="24" 
                                Width="{TemplateBinding Width}" 
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SwitchSongBtnStyle" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="24" 
                                Width="{TemplateBinding Width}" 
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider" x:Key="ProgressSliderStyle">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="{Binding TotalDurationSeconds, FallbackValue=100}"/>
            <Setter Property="Value" Value="{Binding CurrentPositionSeconds, Mode=OneWay}"/>
            <Setter Property="Background" Value="#4D4D4D"/>
            <Setter Property="Foreground" Value="#1DB954"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="AutoToolTipPlacement" Value="None"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="RootGrid" Background="Transparent">

                            <Border x:Name="TrackBackground" 
                            Background="{TemplateBinding Background}" 
                            Height="4" 
                            CornerRadius="2" 
                            VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" 
                                                Height="4" 
                                                CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="12"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="12" Height="12" Opacity="0" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Width="12" Height="12" StrokeThickness="0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#1ED760"/>
                            </Trigger>
                            <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= PlayList ================= -->
        <DockPanel Grid.Column="0" Grid.RowSpan="2" Background="#000000">
            <StackPanel DockPanel.Dock="Top" Margin="20,20,20,10">
                <TextBlock Text="Trackora" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📂  Импорт файлов" 
                        Command="{Binding OpenFileCommand}" 
                        Style="{StaticResource ControlButtonStyle}" 
                        HorizontalAlignment="Left"
                        FontSize="14"
                        Margin="0,0,0,10"/>
                    <Button Content="🌐" 
                        Command="{Binding OpenUrlCommand}" 
                        Style="{StaticResource ControlButtonStyle}" 
                        HorizontalAlignment="Left"
                        FontSize="14"
                        Margin="0,0,0,10"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Command="{Binding ToggleLoopCommand}" 
                Style="{StaticResource ControlButtonStyle}" 
                FontSize="18"
                Padding="8,6"
                Margin="0,0,5,0"
                ToolTip="Цикличное воспроизведение">
                        <Button.Content>
                            <TextBlock Text="🔁"/>
                        </Button.Content>
                        <Button.Foreground>
                            <Binding Path="IsLoopActive" Converter="{StaticResource BoolToColorConv}"/>
                        </Button.Foreground>
                    </Button>

                    <Button Command="{Binding ToggleShuffleCommand}" 
                Style="{StaticResource ControlButtonStyle}" 
                FontSize="18"
                Padding="8,6"
                ToolTip="Случайное воспроизведение">
                        <Button.Content>
                            <TextBlock Text="🔀"/>
                        </Button.Content>
                        <Button.Foreground>
                            <Binding Path="IsShuffleActive" Converter="{StaticResource BoolToColorConv}"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Songs}" 
                     SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                     Background="Transparent" 
                     BorderThickness="0"
                     Margin="0,10,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">

                        <!-- Команда из MainVM — ищем через Window -->
                        <MenuItem Header="🔁 Reload Songs" 
                  Command="{Binding DataContext.ReloadSongsCommand, 
                            RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Separator/>

                        <!-- Остальные команды из MainPageVM — берём из текущего DataContext (Tag) -->
                        <MenuItem Command="{Binding SaveToAppDataCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="💾 Сохранить в библиотеку"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.SelectedItem.IsSavedToAppData, 
                                               RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                     Value="True">
                                            <Setter Property="Header" Value="❌ Удалить из библиотеки"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>

                        <Separator/>

                        <MenuItem Header="🗑️ Удалить из сессии" 
                  Command="{Binding RemoveFromSessionCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        <MenuItem Header="📂 Расположение файла" 
                  Command="{Binding OpenFileLocationCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        <Separator/>

                        <MenuItem Header="✏️ Редактировать метаданные" 
                  Command="{Binding EditMetadataCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        <MenuItem Header="➕ Добавить в очередь" 
                  Command="{Binding AddToQueueCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="Foreground" Value="#B3B3B3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#282828"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▶" FontSize="10" Foreground="#1DB954" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=" • " FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource TimeConv}}" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= Track Info ================= -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="40,20,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  Width="280" Height="280" 
                  Margin="0,30,0,30"
                  HorizontalAlignment="Center">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.6" Color="Black"/>
                </Grid.Effect>

                <Border Background="#282828" CornerRadius="6">
                    <TextBlock Text="🎵" 
                               FontSize="70" 
                               Foreground="#404040" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Image Stretch="UniformToFill" ClipToBounds="True"
                       Source="{Binding SelectedSong.BackgroundImagePath, Converter={StaticResource StrImgConv}}">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,280,280" RadiusX="6" RadiusY="6"/>
                    </Image.Clip>
                </Image>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="450">
                <TextBlock Text="{Binding SelectedSong.Title}" 
                           Foreground="White" 
                           FontSize="28" 
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SelectedSong.Title_Romanized}" 
                           Foreground="#A0A0A0" 
                           FontSize="15" 
                           FontStyle="Italic"
                           TextAlignment="Center"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding SelectedSong.Info}" 
                           Foreground="#DDDDDD" 
                           FontSize="16" 
                           TextAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="{Binding SelectedSong.Album}" 
                           Foreground="#888888" 
                           FontSize="14" 
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>

                <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">

                    <Border Background="#282828" CornerRadius="12" Padding="12,4" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSong.Bpm}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="#B3B3B3" FontSize="11" FontWeight="SemiBold">
                            <Run Text="{Binding SelectedSong.Bpm, Mode=OneWay}"/>
                            <Run Text=" BPM"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- ================= Status Bar ================= -->
        <Border Grid.Column="1" Grid.Row="1" 
                Background="#181818" 
                Padding="30,15"
                BorderBrush="#282828"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Prograss-Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding CurrentPositionSeconds, Converter={StaticResource TimeConv}, FallbackValue=0:00}" 
                               Foreground="#A0A0A0" 
                               FontSize="11" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,10,0"/>

                    <Slider Grid.Column="1" 
                            Style="{StaticResource ProgressSliderStyle}"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" 
                               Text="{Binding TotalDurationSeconds, Converter={StaticResource TimeConv}, FallbackValue=0:00}" 
                               Foreground="#A0A0A0" 
                               FontSize="11" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⏪" Margin="5" FontSize="22"
                            Command="{Binding PlayPrevCommand}"
                            Style="{StaticResource SwitchSongBtnStyle}"
                            ToolTip="Prev"
                            HorizontalAlignment="Center"/>
                        <Button Content="⏯" Margin="5" FontSize="25"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource PlayButtonStyle}"
                            ToolTip="Play / Pause"
                            HorizontalAlignment="Center"/>
                        <Button Content="⏩" Margin="5" FontSize="22"
                            Command="{Binding PlayNextCommand}"
                            Style="{StaticResource SwitchSongBtnStyle}"
                            ToolTip="Next"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="2" 
                               Text="{Binding StatusText}" 
                               Foreground="#666666" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
