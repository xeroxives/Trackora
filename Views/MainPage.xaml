<UserControl x:Class="WpfApp14.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:WpfApp14.Converters"
      xmlns:viewmodels="clr-namespace:WpfApp14.ViewModels"
      xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
      xmlns:ext="clr-namespace:WpfApp14.Extensions"
      d:DataContext="{d:DesignInstance Type=viewmodels:MainPageVM}"
      mc:Ignorable="d" Background="{StaticResource BgPrimary}" >

    <UserControl.Resources>
        <converters:TimeConverter x:Key="TimeConv"/>
        <converters:StringToImageConverter x:Key="StrImgConv"/>
        <converters:ProgressWidthConverter x:Key="ProgressWidthConv"/>
        <converters:BoolToSaveTextConverter x:Key="BoolToSaveTextConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConv"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= PlayList ================= -->
        <DockPanel Grid.Column="0" Grid.RowSpan="3" Background="#000000">
            <StackPanel DockPanel.Dock="Top" Margin="20,20,20,10">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Text="Trackora"
                           Foreground="#FFF"
                            FontSize="{ext:FontSize MainViewText,22}"
                            FontFamily="{ext:FontFamily MainViewText}"
                           FontWeight="Bold"
                               
                           VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                        Width="30" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Style="{StaticResource ControlButtonStyle}"
                        Background="#FFF"
                        ToolTip="Свернуть плейлист">
                        <svg:SvgViewbox Source="./stats.svg"  Margin="4.5"/>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="📂  Импорт файлов"
                        Command="{Binding OpenFileCommand}"
                        Style="{StaticResource ControlButtonStyle}"
                        HorizontalAlignment="Left"
                        FontSize="{ext:FontSize MainViewText,14}"
                        FontFamily="{ext:FontFamily MainViewText}"
                        Margin="0,0,0,10"/>
                    <Button Content="🌐" 
                        Command="{Binding OpenUrlCommand}" 
                        Style="{StaticResource ControlButtonStyle}" 
                        HorizontalAlignment="Left"
                        FontSize="14"
                        Margin="0,0,0,10"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Command="{Binding ToggleLoopCommand}" 
                Style="{StaticResource ControlButtonStyle}" 
                FontSize="18"
                Padding="8,6"
                Margin="0,0,5,0"
                ToolTip="Цикличное воспроизведение">
                        <Button.Content>
                            <TextBlock Text="🔁"/>
                        </Button.Content>
                        <Button.Foreground>
                            <Binding Path="IsLoopActive" Converter="{StaticResource BoolToColorConv}"/>
                        </Button.Foreground>
                    </Button>

                    <Button Command="{Binding ToggleShuffleCommand}" 
                Style="{StaticResource ControlButtonStyle}" 
                FontSize="18"
                Padding="8,6"
                ToolTip="Случайное воспроизведение">
                        <Button.Content>
                            <TextBlock Text="🔀"/>
                        </Button.Content>
                        <Button.Foreground>
                            <Binding Path="IsShuffleActive" Converter="{StaticResource BoolToColorConv}"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Songs}"
                     SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                     Background="Transparent" 
                     BorderThickness="0"
                     Margin="0,10,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <ListBox.Resources>
                    <ResourceDictionary Source="/Themes/StylesMainPage.xaml"/>
                </ListBox.Resources>

                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="🔁 Reload Songs" FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  Command="{Binding ReloadSongsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>

                        <MenuItem Command="{Binding SaveToAppDataCommand}" FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="💾 Сохранить в библиотеку"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.SelectedItem.IsSavedToAppData, 
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                     Value="True">
                                            <Setter Property="Header" Value="❌ Удалить из библиотеки"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator/>

                        <MenuItem Header="🗑️ Удалить из сессии"  FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  Command="{Binding RemoveFromSessionCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="📂 Расположение файла1" FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  Command="{Binding OpenFileLocationCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>

                        <MenuItem Header="✏️ Редактировать метаданные"  FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  Command="{Binding EditMetadataCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="➕ Добавить в очередь"  FontFamily="{ext:FontFamily ContextMenuListBox}" FontSize="{ext:FontSize ContextMenuListBox,12}"
                                  Command="{Binding AddToQueueCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="Foreground" Value="#B3B3B3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#282828"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▶" FontSize="10" Foreground="#1DB954" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontFamily="{ext:FontFamily SongDescriptionInfo_LB}" FontSize="{ext:FontSize SongDescriptionInfo_LB,14}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Info}" FontFamily="{ext:FontFamily SongDescriptionInfo_LB}" FontSize="{ext:FontSize SongDescriptionInfo_LB,11}" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding DurationSeconds, Converter={StaticResource TimeConv}}" FontFamily="{ext:FontFamily SongDescriptionInfo_LB}" FontSize="{ext:FontSize SongDescriptionInfo_LB,11}" Opacity="0.6"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= Track Info ================= -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="40,20,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  Width="280" Height="280" 
                  Margin="0,30,0,30"
                  HorizontalAlignment="Center">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.6" Color="Black"/>
                </Grid.Effect>

                <Border Background="#282828" CornerRadius="6">
                    <TextBlock Text="🎵" 
                               FontSize="70" 
                               Foreground="#404040" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Image Stretch="UniformToFill" ClipToBounds="True"
                       Source="{Binding SelectedSong.BackgroundImagePath, Converter={StaticResource StrImgConv}}">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,280,280" RadiusX="6" RadiusY="6"/>
                    </Image.Clip>
                </Image>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="450">
                <TextBlock Text="{Binding SelectedSong.Title}" 
                           Foreground="White" 
                           FontSize="{ext:FontSize SongDescriptionInfo,28}"
                           FontFamily="{ext:FontFamily SongDescriptionInfo}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SelectedSong.Title_Romanized}" 
                           Foreground="#A0A0A0" 
                           FontSize="{ext:FontSize SongDescriptionInfo,15}"
                           FontFamily="{ext:FontFamily SongDescriptionInfo}"
                           FontStyle="Italic"
                           TextAlignment="Center"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding SelectedSong.Info}" 
                           Foreground="#DDDDDD" 
                           FontSize="{ext:FontSize SongDescriptionInfo,16}"
                           FontFamily="{ext:FontFamily SongDescriptionInfo}"
                           TextAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="{Binding SelectedSong.Album}" 
                           Foreground="#888888" 
                           FontSize="{ext:FontSize SongDescriptionInfo,14}"
                           FontFamily="{ext:FontFamily SongDescriptionInfo}"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>

                <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">

                    <Border Background="#282828" CornerRadius="12" Padding="12,4" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSong.Bpm}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="#B3B3B3" FontSize="11" FontWeight="SemiBold">
                            <Run Text="{Binding SelectedSong.Bpm, Mode=OneWay}"/>
                            <Run Text=" BPM"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- ================= Status Bar ================= -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#181818" 
                Padding="30,15"
                BorderBrush="#282828"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Prograss-Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding CurrentPositionSeconds, Converter={StaticResource TimeConv}, FallbackValue=0:00}" 
                               Foreground="{StaticResource FgTimer}" 
                               FontSize="{ext:FontSize MainViewText,14}"
                               FontFamily="{ext:FontFamily MainViewText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,10,0"/>

                    <Slider Grid.Column="1" 
                            Style="{StaticResource ProgressSliderStyle}"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" 
                               Text="{Binding TotalDurationSeconds, Converter={StaticResource TimeConv}, FallbackValue=0:00}" 
                               Foreground="{StaticResource FgTimer}" 
                               FontSize="{ext:FontSize MainViewText,14}"
                               FontFamily="{ext:FontFamily MainViewText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="50,0,0,0">
                        <Button Content="⏪" Margin="5" FontSize="22"
                            Command="{Binding PlayPrevCommand}"
                            Style="{StaticResource SwitchSongBtnStyle}"
                            ToolTip="Prev"
                            HorizontalAlignment="Center"/>
                        <Button Content="⏯" Margin="5" FontSize="25"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource PlayButtonStyle}"
                            ToolTip="Play / Pause"
                            HorizontalAlignment="Center"/>
                        <Button Content="⏩" Margin="5" FontSize="22"
                            Command="{Binding PlayNextCommand}"
                            Style="{StaticResource SwitchSongBtnStyle}"
                            ToolTip="Next"
                            HorizontalAlignment="Center"/>
                        <Slider
                            Orientation="Horizontal" Height="20" Width="75" Margin="5"
                            Value="{Binding SelectedSongVolume,UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" 
                               Text="{Binding StatusText}" 
                               Foreground="#666666" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
