<Window x:Class="WpfApp14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WpfApp14.Converters"
        xmlns:viewmodels="clr-namespace:WpfApp14.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Trackora Audio Player" 
        Height="600" Width="900"
        MinHeight="400" MinWidth="700"
        Background="#1E1E1E">
    <Window.DataContext>
        <viewmodels:MainVM/>
    </Window.DataContext>
    <Window.Resources>
        <!-- Конвертер времени из мануала -->
        <converters:TimeConverter x:Key="TimeConv"/>
        <converters:StringToImageConverter x:Key="StrImgConv"/>
        <converters:PercentWidthConverter x:Key="PercentWidthConverter"/>
        <!-- Стиль для кнопок управления -->
        <Style TargetType="Button" x:Key="ControlButtonStyle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Плейлист -->
            <ColumnDefinition Width="*"/>
            <!-- Основная зона -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Контент -->
            <RowDefinition Height="Auto"/>
            <!-- Футер управления -->
        </Grid.RowDefinitions>

        <!-- ================= ЛЕВАЯ ПАНЕЛЬ: ПЛЕЙЛИСТ ================= -->
        <DockPanel Grid.Column="0" Grid.RowSpan="2" Background="#252525">
            <!-- Панель инструментов импорта -->
            <StackPanel DockPanel.Dock="Top" Margin="10">
                <TextBlock Text="Библиотека" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="📂 Импорт файлов" 
                        Command="{Binding OpenFileCommand}" 
                        Style="{StaticResource ControlButtonStyle}" 
                        Margin="0,0,0,5"/>
                <Button Content="🧪 Тестовые данные" 
                        Command="{Binding LoadTestDataCommand}" 
                        Style="{StaticResource ControlButtonStyle}" 
                        FontSize="12" Padding="10,5"/>
            </StackPanel>

            <!-- Список треков -->
            <ListBox ItemsSource="{Binding Songs}" 
                     SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                     Background="Transparent" 
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2F2F2F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" 
                                       FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Info}" 
                                           FontSize="11" 
                                           Opacity="0.7"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text=" • " FontSize="11" Opacity="0.7"/>
                                <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource TimeConv}}" 
                                           FontSize="11" 
                                           Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= ПРАВАЯ ПАНЕЛЬ: ИНФО О ТРЕКЕ ================= -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Обложка -->
                <RowDefinition Height="Auto"/>
                <!-- Метаданные -->
                <RowDefinition Height="*"/>
                <!-- Статус / Пустое пространство -->
            </Grid.RowDefinitions>

            <!-- Обложка альбома с безопасным плейсхолдером -->
            <Grid Grid.Row="0" 
                  Width="250" Height="250" 
                  Margin="0,20,0,20"
                  HorizontalAlignment="Center">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                </Grid.Effect>

                <!-- 1. Плейсхолдер (виден всегда, лежит на дне) -->
                <Border Background="#333333" CornerRadius="8">
                    <TextBlock Text="🎵" 
                               FontSize="60" 
                               Foreground="#555555" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Image Stretch="UniformToFill" ClipToBounds="True"
                       Source="{Binding SelectedSong.BackgroundImagePath, Converter={StaticResource StrImgConv}}">

                    <!-- Скругление углов -->
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,250,250" RadiusX="8" RadiusY="8"/>
                    </Image.Clip>
                </Image>
            </Grid>

            <!-- Текстовая информация -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="400">
                <TextBlock Text="{Binding SelectedSong.Title}" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SelectedSong.Title_Romanized}" 
                           Foreground="#AAAAAA" 
                           FontSize="14" 
                           FontStyle="Italic"
                           TextAlignment="Center"
                           Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSong.Title_Romanized}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding SelectedSong.Info}" 
                           Foreground="#DDDDDD" 
                           FontSize="16" 
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock Text="{Binding SelectedSong.Album}" 
                           Foreground="#999999" 
                           FontSize="13" 
                           TextAlignment="Center"
                           Margin="0,2,0,0"/>

                <!-- Дополнительные теги -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Border Background="#333333" CornerRadius="4" Padding="8,3" Margin="3">
                        <TextBlock Foreground="#BBBBBB" FontSize="11">
                            <Run Text="{Binding SelectedSong.Genre, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <Border Background="#333333" CornerRadius="4" Padding="8,3" Margin="3">
                        <TextBlock Foreground="#BBBBBB" FontSize="11">
                            <Run Text="{Binding SelectedSong.BitrateKbps, Mode=OneWay}"/>
                            <Run Text=" kbps"/>
                        </TextBlock>
                    </Border>

                    <!-- BPM показывается только если не null -->
                    <Border Background="#333333" CornerRadius="4" Padding="8,3" Margin="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSong.Bpm}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="#BBBBBB" FontSize="11">
                            <Run Text="{Binding SelectedSong.Bpm, Mode=OneWay}"/>
                            <Run Text=" BPM"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- ================= ФУТЕР: УПРАВЛЕНИЕ И СТАТУС ================= -->
        <Border Grid.Column="1" Grid.Row="1" 
                Background="#2A2A2A" 
                Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Прогресс-бар -->
                <ProgressBar Grid.Row="0" 
                             Height="6" 
                             Background="#333333" 
                             Foreground="#1DB954"
                             BorderThickness="0"
                             Margin="0,0,0,10"
                             Minimum="0"
                             Maximum="{Binding TotalDurationSeconds}"
                             Value="{Binding CurrentPositionSeconds, Mode=OneWay}"/>

                <DockPanel Grid.Row="1">
                    <!-- Статус текст справа -->
                    <TextBlock DockPanel.Dock="Right" 
                               Text="{Binding StatusText}" 
                               Foreground="#888888" 
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Кнопка Play/Pause по центру -->
                    <Button Content="⏯ Play / Pause" 
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource ControlButtonStyle}"
                            HorizontalAlignment="Center"
                            MinWidth="160"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>