<Window x:Class="WpfApp14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp14.ViewModels"
        xmlns:views="clr-namespace:WpfApp14.Views"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="Trackora" 
        Height="650" Width="950"
        MinHeight="500" MinWidth="750"
        Background="#121212">

    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>

    <Window.Resources>
        
        <DataTemplate DataType="{x:Type vm:MainPageVM}">
            <views:MainPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsVM}">
            <views:SettingsPage/>
        </DataTemplate>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover эффект -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>

                            <!-- Эффект нажатия -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>

                            <!-- Неактивная кнопка -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" 
            Grid.Column="0" 
            Width="47"
            Background="#181818">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="47"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Width" Value="49"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Плавная анимация через EventTrigger -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="Width"
                            To="49"
                            Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="Width"
                            To="47"
                            Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel Background="#181818" HorizontalAlignment="Center" Margin="5">
                <Button Command="{Binding MainPageCommand}" Style="{StaticResource IconButtonStyle}">
                    <svg:SvgViewbox Source="./menu.svg" Margin="5"/>
                </Button>
                <Button Command="{Binding SettingsCommand}" Style="{StaticResource IconButtonStyle}">
                    <svg:SvgViewbox Source="./settings.svg"  Margin="5"/>
                </Button>
                <Button Command="{Binding StatsCommand}" Style="{StaticResource IconButtonStyle}">
                    <svg:SvgViewbox Source="./stats.svg"  Margin="4.5"/>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentVM}" />

    </Grid>
</Window>